# Copy to .env for local runs (`kairos serve` doesn't read it; use your shell,
# direnv, or `docker run --env-file .env`). See README for every option.

# One JSON array, one object per calendar.
CALDAV_SOURCES=[{"id":"icloud","name":"iCloud Personal","url":"https://caldav.icloud.com/","username":"your-email@icloud.com","password":"xxxx-xxxx-xxxx-xxxx","calendar_path":"https://p178-caldav.icloud.com/ACCOUNT_ID/calendars/CALENDAR_UUID/","timezone":"America/New_York","writable":true}]
DEFAULT_TIMEZONE=America/New_York

# Bearer tokens for REST and /mcp, comma-separated, 32+ characters each.
# Generate with: openssl rand -hex 32
KAIROS_API_TOKENS=

# Optional: OAuth for /mcp through your own identity provider.
# KAIROS_PUBLIC_URL=https://cal.example.com
# KAIROS_OIDC_ISSUER=https://auth.example.com/application/o/kairos/
# KAIROS_OIDC_ALLOWED_SUBJECTS=

LOG_LEVEL=info
